# Copy to .env and fill in values (do not commit .env)

# --- Databricks (required) ---
# Workspace URL, e.g. https://adb-xxxx.19.azuredatabricks.net
DATABRICKS_HOST=https://adb-2376768479807879.19.azuredatabricks.net

# --- Service principal (required when AUTH_METHOD=service_principal in src/chatx/const.py) ---
# Create in Databricks: Settings → Developer → Service principals, or via OAuth M2M
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# --- Azure Bot (required for Teams / Bot Framework) ---
# From Azure Bot resource → Configuration: Microsoft App ID and create a client secret
APP_ID=
APP_PASSWORD=

# --- OAuth (only if AUTH_METHOD=oauth) ---
# OAUTH_CONNECTION_NAME=databricks
